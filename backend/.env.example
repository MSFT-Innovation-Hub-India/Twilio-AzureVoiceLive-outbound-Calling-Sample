# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Azure Voice Live API (GPT-Realtime)
# Authentication uses DefaultAzureCredential (managed identity / Azure CLI / env creds)
# No API key needed — ensure your identity has "Cognitive Services OpenAI User" role
AZURE_OPENAI_ENDPOINT=https://agent-svc-project-resource.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-realtime
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Server
HOST=0.0.0.0
PORT=8000
PUBLIC_URL=https://your-ngrok-or-public-url.ngrok-free.app

# Azure Voice Live API (Cognitive Services endpoint)
AZURE_VOICE_LIVE_ENDPOINT=https://agent-svc-project-resource.cognitiveservices.azure.com
AZURE_VOICE_LIVE_API_VERSION=2025-05-01-preview
VOICE_LIVE_MODEL=gpt-realtime-1.5
AZURE_TTS_VOICE_NAME=en-US-AriaNeural

# Agent Configuration
SYSTEM_PROMPT=You are a helpful voice assistant. Be concise and conversational. You are speaking with someone on a phone call.
VOICE=alloy

# Azure Cosmos DB (uses DefaultAzureCredential — no keys needed)
AZURE_COSMOS_DB_ENDPOINT=https://<cosmosdb>.documents.azure.com:443/
AZURE_COSMOS_DB_DATABASE=db001
AZURE_COSMOS_DB_CONTAINER=sales-screening-oall-output

# Azure Cosmos DB Management (for auto-enabling public network access)
AZURE_SUBSCRIPTION_ID=<sub-id>
AZURE_RESOURCE_GROUP=common-svc-rg
AZURE_COSMOS_DB_ACCOUNT_NAME=common-nosql-db
